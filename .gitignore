.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
# Examples carry placeholder values only and are what the README tells you to copy.
!example.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Child modules do not need their own lock file; only root configurations do.
modules/**/.terraform.lock.hcl
terraform/modules/**/.terraform.lock.hcl

# macOS
.DS_Store

# local secrets: never commit
.env
.env.*
!.env.example
